def plot_case(case_id, z_cont, z_reset, window_len, tag):
    t = times_phys[case_id]
    true = states_phys[case_id]
    items = [("T", 0)] + [(s, 1 + species_names.index(s))
                          for s in PLOT_SPECIES if s in species_names]
    ncol = 3
    nrow = int(np.ceil(len(items) / ncol))
    fig, axes = plt.subplots(nrow, ncol, figsize=(5.2 * ncol, 3.4 * nrow))
    axes = np.atleast_1d(axes).ravel()
    pc = z_to_physical(z_cont, case_id) if z_cont is not None else None
    pr = z_to_physical(z_reset, case_id) if z_reset is not None else None
    for ax, (name, col) in zip(axes, items):
        ax.plot(t, true[:, col], "k-", lw=1.6, label="True (Cantera)")
        if pr is not None:
            ax.plot(t, pr[:, col], "r--", lw=1.1,
                    label=f"reset (w={window_len})")
        if pc is not None:
            ax.plot(t, pc[:, col], "b-.", lw=1.1, label="continuous (t=0)")
        ax.set_xscale("symlog", linthresh=max(t[t > 0].min(), 1e-12))
        if col > 0:
            ax.set_yscale("log")
            ax.set_ylabel("mass fraction")
        else:
            ax.set_ylabel("K")
        ax.set_title(name)
        ax.set_xlabel("time (s)")
        ax.grid(alpha=0.3)
        ax.legend(fontsize=7)
    for ax in axes[len(items):]:
        ax.axis("off")
    fig.suptitle(f"case {case_id} -- {tag}")
    fig.tight_layout()
    out = OUT_DIR / f"eval_case{case_id}_{tag}.png"
    fig.savefig(out, dpi=150, bbox_inches="tight")
    plt.close(fig)
    return out


@torch.no_grad()
def predict_trajectory(T0_K, Y0, P_bar, times_s):
    """Stand-alone use of the trained model, in PHYSICAL units.

    T0_K : float               initial temperature [K]
    Y0   : array (n_species,)  initial mass fractions, in `species_names` order
    P_bar: float               pressure [bar(a)]
    times_s: increasing array, times_s[0] is the initial time
    -> (len(times), 1 + n_species) array of [T, Y...] in physical units.
    """
    field.eval()
    x0 = np.concatenate([[float(T0_K)],
                         np.log10(np.clip(np.asarray(Y0, float), 0, None) + LOG_EPS)])
    z0 = torch.tensor((x0[keep] - center) / scale, dtype=DTYPE, device=device)
    t = torch.tensor(np.asarray(times_s, float), dtype=torch.float64, device=device)
    D = (t[-1] - t[0]).reshape(1, 1).to(DTYPE)
    taus = ((t - t[0]) / (t[-1] - t[0])).reshape(1, -1).to(DTYPE)
    p = torch.tensor([[(float(P_bar) - p_center) / p_scale]], dtype=DTYPE, device=device)
    z, failed = integrate_windows(z0.reshape(1, -1), p, D, taus,
                                  rtol=RTOL_EVAL, atol=ATOL_EVAL,
                                  max_steps=MAX_STEPS_EVAL)
    if bool(failed[0]):
        raise RuntimeError("integration did not finish -- check the state/P "
                           "are inside the training range")
    return z_to_physical(z[0].cpu().numpy(),
                         const=np.concatenate([[float(T0_K)], np.asarray(Y0, float)]))


def plot_history(stage_name):
    ck = OUT_DIR / stage_name / "latest.pt"
    if not ck.exists():
        return
    h = torch.load(ck, map_location="cpu", weights_only=False)["history"]
    if not h:
        return
    ep = [d["epoch"] for d in h]
    fig, ax = plt.subplots(figsize=(6, 4))
    ax.semilogy(ep, [d["train"] for d in h], label="train")
    ax.semilogy(ep, [d["val"] for d in h], label="val (trajectory only)")
    ax.set_xlabel("epoch"); ax.set_ylabel("loss"); ax.set_title(f"stage {stage_name}")
    ax.grid(alpha=0.3); ax.legend()
    fig.tight_layout()
    fig.savefig(OUT_DIR / f"history_{stage_name}.png", dpi=140)
    plt.close(fig)


def final_evaluation(tag="final"):
    """Test-set evaluation.  The CONTINUOUS rollout (one solve from the initial
    state, as in deployment) is the result; the reset rollout restarts from
    true states and is only computed with --eval_reset, as a diagnostic."""
    print(f"\n=== final evaluation on TEST cases (true sample times) ===", flush=True)
    res_c, res_r, kept = [], [], {}
    for c in test_idx:
        zc, how = continuous_rollout(int(c))
        res_c.append(case_metrics(c, zc))
        zr = None
        if EVAL_RESET:
            zr = reset_rollout(int(c), EVAL_RESET_WINDOW, EVAL_RESET_OVERLAP)
            res_r.append(case_metrics(c, zr))
        if len(kept) < PLOT_CASES:
            kept[int(c)] = (zc, zr)
    a_c = summarize(res_c, "continuous rollout (single solve from t=0)")
    a_r = (summarize(res_r, f"reset rollout (w={EVAL_RESET_WINDOW}, "
                            f"o={EVAL_RESET_OVERLAP}) [diagnostic only]")
           if EVAL_RESET else None)
    for c, (zc, zr) in kept.items():
        print(f"  plot: {plot_case(c, zc, zr, EVAL_RESET_WINDOW, tag)}", flush=True)
    out = {"continuous": a_c, "n_test": len(test_idx),
           "stages": [s_["name"] for s_ in STAGES]}
    if EVAL_RESET:
        out["reset"] = a_r
    path = OUT_DIR / f"{tag}_metrics.json"
    with open(path, "w") as f:
        json.dump(out, f, indent=2)
    print(f"  metrics: {path}", flush=True)
    return a_c, a_r


# ----------------------------------------------------------------------------
# 10. RUN
# ----------------------------------------------------------------------------

if __name__ == "__main__":
    t_start = time.time()
    pretrain()
    if STOP_AFTER_PRETRAIN:
        print(f"\n=== derivative accuracy of the pretrained field "
              f"({N_HIDDEN_LAYERS} x {HIDDEN_DIM}, {n_par/1e3:.1f}k parameters) ===",
              flush=True)
        rep_ = {"hidden_dim": HIDDEN_DIM, "n_hidden_layers": N_HIDDEN_LAYERS,
                "parameters": n_par, "pretrain_steps": PRETRAIN_STEPS,
                "train": pretrain_report("train"), "val": pretrain_report("val")}
        path = OUT_DIR / "pretrain_report.json"
        with open(path, "w") as f:
            json.dump(rep_, f, indent=2)
        print(f"  report: {path}\n(--stop_after pretrain: stopping here)", flush=True)
        sys.exit(0)
    print("\npost-pretraining sanity rollout (no shooting yet):", flush=True)
    summarize([case_metrics(c, continuous_rollout(
                   int(c), allow_fallback=False, max_steps=MAX_STEPS_MONITOR)[0])
               for c in val_idx[:N_ROLLOUT_CASES]], "  continuous")
    for stage in STAGES:
        train_stage(stage)
        plot_history(stage["name"])
    last = STAGES[-1]["name"] if STAGES else "pretrain"
    # plots / metrics are named after the last stage, so the results of an
    # earlier run (e.g. after "full") are not overwritten by a later one
    final_evaluation(tag=f"final_{last}")
    final_path = OUT_DIR / "final_model.pt"
    backup = OUT_DIR / f"final_model_before_{last}.pt"
    if final_path.exists() and not backup.exists():
        prev = torch.load(final_path, map_location="cpu", weights_only=False)
        if prev.get("last_stage") != last:
            final_path.replace(backup)
            print(f"previous final model kept as {backup}", flush=True)
    torch.save({"model": field.state_dict(), "center": center, "scale": scale,
                "keep": keep, "kept_names": kept_names, "p_center": p_center,
                "p_scale": p_scale, "log_eps": LOG_EPS, "r_lo": R_LO, "r_hi": R_HI,
                "rate_groups": GROUP_NAMES, "inert": inert,
                "element_conservation": bool(field._elem_on), "elements": ELEMENTS,
                "last_stage": last,
                "settings": {s_["name"]: (str(s_["value"]) if isinstance(s_["value"], Path)
                                          else s_["value"])
                             for s_ in _SETTINGS.values()}},
               final_path)
    print(f"final model: {final_path}", flush=True)
    print(f"\ntotal wall time {(time.time()-t_start)/60:.1f} min", flush=True)

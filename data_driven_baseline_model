val_idx = np.sort(perm[n_tr:n_tr + n_va])
test_idx = np.sort(perm[n_tr + n_va:])
print(f"split: train {len(train_idx)} | val {len(val_idx)} | test {len(test_idx)}",
      flush=True)


# --- forward / inverse transform -------------------------------------------
# x = [T, log10(Y + eps)]   ->   z = (x - center) / scale   (roughly [-1, 1])

def phys_to_log(states, derivs=None):
    T = states[..., :1]
    Y = states[..., 1:]
    L = np.log10(Y + LOG_EPS)
    x = np.concatenate([T, L], axis=-1)
    if derivs is None:
        return x
    dT = derivs[..., :1]
    dL = derivs[..., 1:] / ((Y + LOG_EPS) * np.log(10.0))
    return x, np.concatenate([dT, dL], axis=-1)


x_all, dx_all = phys_to_log(states_phys, derivs_phys)

# Channel selection + scaling fitted on TRAIN cases only.
x_train = x_all[train_idx]
ch_min = x_train.min(axis=(0, 1))
ch_max = x_train.max(axis=(0, 1))
raw_span = ch_max - ch_min

if DROP_CONSTANT_CHANNELS:
    keep = raw_span > 1e-12
    keep[0] = True
else:
    keep = np.ones(n_raw, dtype=bool)
# v7: inert species (e.g. N2 in a steam/N2 feed) are constant in TIME within a
# case but can differ BETWEEN cases (their mass fraction depends on O2/CH4 and
# H2O/CH4).  They are removed from the learned state -- the true rate is
# exactly zero, nothing to learn -- and each case's own initial value is used.
inert = []
for s_ in INERT_SPECIES:
    if s_ not in species_names:
        continue
    k_ = 1 + species_names.index(s_)
    y_ = states_phys[..., k_]
    tspan = float(np.max(y_.max(axis=1) - y_.min(axis=1)))
    if tspan <= 1e-9 * max(float(y_.max()), 1e-30) + 1e-14:
        keep[k_] = False
        inert.append(s_)
    else:
        print(f"warning: {s_} is listed as inert but changes in time (by up to "
              f"{tspan:.2e}); it stays in the learned state", flush=True)
dropped = [("T" if i == 0 else species_names[i - 1]) for i in np.flatnonzero(~keep)]
if dropped:
    print(f"not learned (constant in time, restored per case from the initial "
          f"state): {dropped}", flush=True)
CONST_BY_CASE = states_phys[:, 0, :].copy()     # [C, n_raw] initial state per case
const_values = CONST_BY_CASE[0].copy()          # fallback when no case is given

channel_names = ["T"] + species_names
kept_names = [channel_names[i] for i in np.flatnonzero(keep)]
n_state = int(keep.sum())

center = 0.5 * (ch_max + ch_min)[keep]
scale = 0.5 * raw_span[keep]
# floor the species scales (channel 0 = T is in Kelvin and needs no floor)
scale[1:] = np.maximum(scale[1:], MIN_HALF_RANGE)
scale[0] = max(scale[0], 1.0)

z_all = (x_all[..., keep] - center) / scale
v_all = dx_all[..., keep] / scale            # dz/dt, 1/s, normalized units

p_center = 0.5 * (pressures[train_idx].max() + pressures[train_idx].min())
p_scale = max(0.5 * (pressures[train_idx].max() - pressures[train_idx].min()), 1e-9)
p_all = (pressures - p_center) / p_scale

print(f"state dim: {n_state} | |z| max on train: {np.abs(z_all[train_idx]).max():.2f}",
      flush=True)

# --- element matrix (v8) ----------------------------------------------------
import re as _re
_ATOMIC_W = {"C": 12.011, "H": 1.008, "O": 15.999, "N": 14.007, "AR": 39.948,
             "HE": 4.0026}


def element_counts(name):
    """GRI-style species name -> {element: atoms} ('CH2(S)' -> CH2, 'AR')."""
    u = name.upper()
    if u in ("AR", "HE"):
        return {u: 1}
    base = _re.sub(r"\(.*?\)", "", u)
    out = {}
    for el, n in _re.findall(r"(AR|HE|[CHON])(\d*)", base):
        out[el] = out.get(el, 0) + (int(n) if n else 1)
    if _re.sub(r"(AR|HE|[CHON])\d*", "", base):
        sys.exit(f"error: cannot read the elements of species {name!r} for the "
                 f"element-conservation projection")
    return out


_counts = [element_counts(s_) for s_ in species_names]
ELEMENTS = [e for e in ("C", "H", "O", "N")
            if any(e in c_ for k_, c_ in enumerate(_counts) if keep[1 + k_])]
M_full = np.zeros((len(species_names), len(ELEMENTS)))       # [species, elements]
for k_, c_ in enumerate(_counts):
    w_k = sum(_ATOMIC_W[e] * n for e, n in c_.items())
    for j_, e in enumerate(ELEMENTS):
        M_full[k_, j_] = c_.get(e, 0) * _ATOMIC_W[e] / w_k
# per kept variable (row 0 = T -> zeros)
M_kept = np.zeros((n_state, len(ELEMENTS)))
for j_, ch in enumerate(np.flatnonzero(keep)):
    if ch > 0:
        M_kept[j_] = M_full[ch - 1]
# check on the data itself: elements conserved along every true trajectory,
# and the true derivatives satisfy the constraint
_b = np.einsum("cnk,ke->cne", states_phys[..., 1:], M_full)
_drift = np.abs(_b - _b[:, :1]) / np.maximum(_b[:, :1], 1e-30)
_dY = derivs_phys[..., 1:]
_res = np.abs(np.einsum("cnk,ke->cne", _dY, M_full)) / np.maximum(
    np.einsum("cnk,ke->cne", np.abs(_dY), M_full), 1e-300)
print(f"elements {ELEMENTS}: largest drift along the TRUE trajectories "
      f"{100*_drift.max():.2e} % | true derivatives: median relative "
      f"element residual {np.median(_res):.1e}"
      + (" | projection ON (v8)" if ELEMENT_CONSERVATION else " | projection OFF"),
      flush=True)
if _drift.max() > 1e-3:
    print("warning: the data itself does not conserve the elements to 0.1 % -- "
          "check the species / element table", flush=True)

# --- rate groups (v7) -------------------------------------------------------
_groups = ([] if str(RATE_GROUPS).strip().lower() in ("none", "") else
           [[x.strip() for x in g_.split(",") if x.strip()]
            for g_ in str(RATE_GROUPS).split(";") if g_.strip()])
_seen = set()
for g_ in _groups:
    for x in g_:
        if x not in kept_names:
            sys.exit(f"error: RATE_GROUPS: {x!r} is not a state variable "
                     f"(variables: {kept_names})")
        if x in _seen:
            sys.exit(f"error: RATE_GROUPS: {x!r} is in two groups")
        _seen.add(x)
g_idx = np.full(n_state, len(_groups), dtype=np.int64)       # rest -> last group
for gi_, g_ in enumerate(_groups):
    for x in g_:
        g_idx[kept_names.index(x)] = gi_
N_GROUPS = len(_groups) + 1
GROUP_NAMES = ["+".join(g_) for g_ in _groups] + ["rest"]
if not (g_idx == len(_groups)).any():
    sys.exit("error: RATE_GROUPS leaves no variable for the last group")


def group_speed(v):
    """[..., S] -> [..., G]: sqrt(sum_{k in g} v_k^2 + FLOOR^2)."""
    out = np.stack([np.sqrt((v[..., g_idx == g] ** 2).sum(-1) + VELOCITY_FLOOR ** 2)
                    for g in range(N_GROUPS)], axis=-1)
    return out


# --- log-rate statistics (per group) ---------------------------------------
speed_train = np.sqrt((v_all[train_idx] ** 2).sum(-1) + VELOCITY_FLOOR ** 2)
gspeed_train = group_speed(v_all[train_idx])                    # [c, N, G]
r_train = np.log(np.minimum(gspeed_train, SPEED_CAP))           # [c, N, G]
R_LO = [float(r_train[..., g].min()) - 1.0 - RATE_MARGIN_NATS for g in range(N_GROUPS)]
R_HI = [float(r_train[..., g].max()) + RATE_MARGIN_NATS for g in range(N_GROUPS)]
R_INIT = [float(np.median(r_train[..., g])) for g in range(N_GROUPS)]
frac_capped = float((gspeed_train > SPEED_CAP).mean())
for g in range(N_GROUPS):
    print(f"rate group {g} ({GROUP_NAMES[g]}, {int((g_idx == g).sum())} variables): "
          f"log-rate data [{r_train[..., g].min():.2f}, {r_train[..., g].max():.2f}] "
          f"nats, model bounded to [{R_LO[g]:.2f}, {R_HI[g]:.2f}]", flush=True)
print(f"{100*frac_capped:.2f}% of group target rates capped at {SPEED_CAP:.0e} 1/s",
      flush=True)

# channel weights (used in every loss)
ch_w = np.ones(n_state)
ch_w[0] = T_CHANNEL_WEIGHT
for _j, _name in enumerate(kept_names):
    if _name in MAJOR_SPECIES:
        ch_w[_j] = MAJOR_SPECIES_WEIGHT
ch_w = ch_w / ch_w.sum() * n_state

# --- tensors ---------------------------------------------------------------
Z = torch.tensor(z_all, dtype=DTYPE, device=device)          # [C, N, S]
V = torch.tensor(v_all, dtype=DTYPE, device=device)          # [C, N, S]
# Physical times are ALWAYS kept in float64, whatever DTYPE is: a window that
# starts at t0 = 1e-3 s and has samples 1e-9 s apart needs (t - t0) to ~9
# significant digits, which float32 (7 digits) cannot give.  Durations and
# taus are computed in float64 and only then cast to DTYPE.
TT = torch.tensor(times_phys, dtype=torch.float64, device=device)    # [C, N]
PP = torch.tensor(p_all, dtype=DTYPE, device=device)         # [C]
CHW = torch.tensor(ch_w, dtype=DTYPE, device=device)         # [S]
# majors in plain mass fraction (for the majors_y_weight loss term)
MAJ_Z_IDX = torch.tensor([kept_names.index(s_) for s_ in MAJOR_SPECIES
                          if s_ in kept_names], dtype=torch.long, device=device)
MAJ_CENTER = torch.tensor(center, dtype=DTYPE, device=device)[MAJ_Z_IDX]
MAJ_SCALE = torch.tensor(scale, dtype=DTYPE, device=device)[MAJ_Z_IDX]

aug_states, aug_derivs = (None, None) if RETURN_FRACTION > 0 else load_augmented()
if RETURN_FRACTION > 0:
    if AUG_FRACTION > 0:
        sys.exit("error: RETURN_FRACTION and AUG_FRACTION are two different kinds of "
                 "off-data points -- use one of them")
    # v9: controlled-return points.  For every data point: a perturbation whose
    # size is log-uniform in [SIGMA_MIN, SIGMA_MAX] (normalized z units), kept
    # inside the state box; target = parent velocity - K * delta.
    _gr = torch.Generator(device="cpu")
    _gr.manual_seed(SEED + 1)
    _zc = torch.tensor(z_all, dtype=torch.float64)                  # [C, N, S]
    _vc = torch.tensor(v_all, dtype=torch.float64)
    _gsp = torch.tensor(np.minimum(group_speed(v_all), SPEED_CAP))   # [C, N, G]
    if RETURN_K_MODE == "group":
        _K = RETURN_KAPPA * _gsp[..., torch.as_tensor(g_idx)]        # [C, N, S]
    else:
        _K = RETURN_KAPPA * (_vc.abs().clamp(max=SPEED_CAP) + VELOCITY_FLOOR)
    _hi = 1.0 + (STATE_BOX_MARGIN or 0.0)
    _zs, _vs = [], []
    for _ in range(int(RETURN_PER_POINT)):
        _u = torch.rand(_zc.shape[:2] + (1,), generator=_gr, dtype=torch.float64)
        _sig = RETURN_SIGMA_MIN * (RETURN_SIGMA_MAX / RETURN_SIGMA_MIN) ** _u
        _d = _sig * torch.randn(_zc.shape, generator=_gr, dtype=torch.float64)
        if RETURN_VARIABLES == "fast":
            # T and the majors define WHICH trajectory (operating point) a state
            # is on: a different value there is another valid case, not an
            # error, so it must not be pulled back to the parent
            _fast = torch.tensor([0.0 if (nm == "T" or nm in MAJOR_SPECIES) else 1.0
                                  for nm in kept_names], dtype=torch.float64)
            _d = _d * _fast
        if int(RETURN_N_PERTURBED) > 0:
            # keep the n largest of a random ranking -> n random variables per point
            _rk = torch.rand(_zc.shape, generator=_gr, dtype=torch.float64)
            _th = torch.topk(_rk, int(RETURN_N_PERTURBED), dim=-1).values[..., -1:]
            _d = _d * (_rk >= _th)
        _zp = (_zc + _d).clamp(-_hi, _hi)
        _zs.append(_zp)
        _vs.append(_vc - _K * (_zp - _zc))
    AZ = torch.cat(_zs, dim=1).to(device, DTYPE)                     # [C, N*P, S]
    AV = torch.cat(_vs, dim=1).to(device, DTYPE)
    n_aug_points = AZ.shape[1]
    AUG_FRACTION = float(RETURN_FRACTION)
    print(f"controlled-return points (v9): {AZ.shape[0]} x {n_aug_points}, "
          f"perturbation {RETURN_SIGMA_MIN:g}..{RETURN_SIGMA_MAX:g} (log-uniform), "
          f"variables: {RETURN_VARIABLES}, pull-back {RETURN_KAPPA:g} x "
          f"{'group' if RETURN_K_MODE == 'group' else 'own'} speed, "
          f"{100*RETURN_FRACTION:.0f}% of "
          f"every collocation batch", flush=True)
    del _zc, _vc, _gsp, _K, _zs, _vs
elif aug_states is not None and AUG_FRACTION > 0:
    ax, adx = phys_to_log(aug_states, aug_derivs)
    AZ = torch.tensor((ax[..., keep] - center) / scale, dtype=DTYPE, device=device)
    AV = torch.tensor(adx[..., keep] / scale, dtype=DTYPE, device=device)
    n_aug_points = AZ.shape[1]
    print(f"augmented collocation points: {AZ.shape[0]} x {n_aug_points} "
          f"(|z| max {AZ.abs().max():.2f})", flush=True)
else:
    AZ = AV = None
    n_aug_points = 0
    if AUG_FRACTION > 0:
        print("no augmented collocation points found -- run "
              "augment_collocation.py to create them (strongly recommended, "
              "see the header of that file)", flush=True)

G_IDX = torch.tensor(g_idx, device=device)                   # [S] group of each variable


def _targets(Vx):
    """v7: per-GROUP speed, direction normalized by the group speed, one
    log-rate target per group; SPEED (total) is kept for the relative-error
    metric."""
    sp = torch.sqrt((Vx ** 2).sum(-1) + VELOCITY_FLOOR ** 2)                   # [C, N]
    gs = torch.stack([torch.sqrt((Vx[..., G_IDX == g] ** 2).sum(-1) + VELOCITY_FLOOR ** 2)
                      for g in range(N_GROUPS)], dim=-1)                      # [C, N, G]
    gs_c = torch.clamp(gs, max=SPEED_CAP)
    h = Vx / gs[..., G_IDX]                                   # |h*_group| <= 1
    v_t = h * gs_c[..., G_IDX]                                # capped target velocity
    sp_c = torch.sqrt((v_t ** 2).sum(-1) + VELOCITY_FLOOR ** 2)
    return sp, sp_c, h, torch.log(gs_c), v_t


# SPEED_C: total speed of the capped target (denominator of the relative
# error); R_TGT: [C, N, G] log-rate per group; H_TGT: group-normalized.
SPEED, SPEED_C, H_TGT, R_TGT, V_TGT = _targets(V)

if AZ is not None:
    A_SPEED, A_SPEED_C, A_H_TGT, A_R_TGT, A_V_TGT = _targets(AV)

train_t = torch.tensor(train_idx, device=device)
val_t = torch.tensor(val_idx, device=device)


def z_to_physical(z, case_id=None, const=None):
    """[..., n_state] normalized -> [..., n_raw] physical (T [K], Y [-]).

    Channels that are not learned (inert / constant) are filled from `const`
    (a physical [T, Y...] vector), else from case `case_id`'s initial state,
    else from case 0 (only right when those channels are the same in every
    case -- pass the case whenever it is known)."""
    z = np.asarray(z)
    x = z * scale + center                      # [T, log10(Y + eps)] for kept
    out = np.empty(z.shape[:-1] + (n_raw,), dtype=np.float64)
    if const is not None:
        out[...] = np.asarray(const, dtype=np.float64)
    elif case_id is not None:
        out[...] = CONST_BY_CASE[int(case_id)]
    else:
        out[...] = const_values
    T = np.empty(z.shape[:-1] + (1,))
    Y = out[..., 1:].copy()
    kept_ix = np.flatnonzero(keep)
    for j, ch in enumerate(kept_ix):
        if ch == 0:
            T[..., 0] = x[..., j]
        else:
            Y[..., ch - 1] = np.clip(10.0 ** x[..., j] - LOG_EPS, 0.0, None)
    return np.concatenate([T, Y], axis=-1)


# ----------------------------------------------------------------------------
# 3. MODEL:  dz/dt = exp(r(z,P)) * h(z,P)
# ----------------------------------------------------------------------------

class RateField(nn.Module):
    """Autonomous conditioned vector field.

    Outputs are factorized into a bounded scalar LOG-RATE r (how fast the
    chemistry is moving at this state, in nats of 1/s) and an O(1) DIRECTION
    h (which way, and the relative magnitude per channel).  This is the whole
    reason the network can cover ~16 decades of dz/dt without the exponential
    output sensitivity of a symlog head: only r is exponentiated, r is bounded
    by the data's own rate range, and the loss decomposes into a relative
    speed error plus a direction error -- the error model that actually
    controls trajectory accuracy.
    """

    def __init__(self, state_dim, hidden=HIDDEN_DIM, layers=N_HIDDEN_LAYERS,
                 r_lo=R_LO, r_hi=R_HI, r_init=None):
        # v7: r_lo / r_hi / r_init are lists, one entry per rate group
        super().__init__()
        act = {"silu": nn.SiLU, "gelu": nn.GELU, "tanh": nn.Tanh}[ACTIVATION]
        seq, d = [], state_dim + 1           # + pressure
        for _ in range(layers):
            seq += [nn.Linear(d, hidden), act()]
            d = hidden
        self.trunk = nn.Sequential(*seq)
        self.head_r = nn.Linear(hidden, N_GROUPS)
        self.head_h = nn.Linear(hidden, state_dim)
        self.register_buffer("r_lo", torch.tensor(r_lo, dtype=DTYPE))
        self.register_buffer("r_hi", torch.tensor(r_hi, dtype=DTYPE))
        self.register_buffer("g_idx", G_IDX.clone())
        # v8: element-conservation projection (buffers are saved with the model,
        # so analysis scripts and the GUI apply exactly what was trained)
        smask = np.zeros(state_dim)
        smask[1:] = 1.0                                     # species channels
        self.register_buffer("elem_M", torch.tensor(M_kept, dtype=DTYPE))
        self.register_buffer("elem_center", torch.tensor(center * smask, dtype=DTYPE))
        self.register_buffer("elem_scale", torch.tensor(scale, dtype=DTYPE))
        self.register_buffer("elem_smask", torch.tensor(smask, dtype=DTYPE))
        self.register_buffer("elem_on", torch.tensor(1.0 if ELEMENT_CONSERVATION else 0.0,
                                                     dtype=DTYPE))
        self._elem_on = bool(ELEMENT_CONSERVATION)
        for m in self.modules():
            if isinstance(m, nn.Linear):
                nn.init.xavier_uniform_(m.weight, gain=0.8)
                nn.init.zeros_(m.bias)
        # small (not zero) direction head: zero would leave dv/dr = 0, i.e. no
        # gradient at all for the rate head at initialization.
        nn.init.xavier_uniform_(self.head_h.weight, gain=0.05)
        if r_init is not None:                 # start at each group's median rate
            nn.init.zeros_(self.head_r.weight)
            with torch.no_grad():
                for g, (ri, lo, hi) in enumerate(zip(r_init, r_lo, r_hi)):
                    frac = min(max((float(ri) - lo) / (hi - lo), 1e-3), 1 - 1e-3)
                    self.head_r.bias[g] = math.log(frac / (1 - frac))

    def forward(self, z, p):
        """z [..., S], p [..., 1] -> r [..., G] (one log-rate per group), h [..., S]"""
        f = self.trunk(torch.cat([z, p], dim=-1))
        r = self.r_lo + (self.r_hi - self.r_lo) * torch.sigmoid(self.head_r(f))
        h = self.head_h(f)
        return r, h

    def raw_velocity(self, z, p):
        """dz/dt without the box gate: exp(r_group(k)) * h_k."""
        r, h = self.forward(z, p)
        return torch.exp(r)[..., self.g_idx] * h

    def velocity(self, z, p):
        v = self.raw_velocity(z, p)
        if STATE_BOX_MARGIN is not None:
            hi = 1.0 + STATE_BOX_MARGIN
            w = STATE_BOX_SOFTNESS
            gate_up = torch.sigmoid((hi - z) / w)     # -> 0 at the upper wall
            gate_dn = torch.sigmoid((z + hi) / w)     # -> 0 at the lower wall
            v = torch.where(v > 0, v * gate_up, v * gate_dn)
        if self._elem_on:
            v = self.conserve_elements(z, v)
        return v

    def element_matrix_at(self, z):
        """A [..., S, E]: d(element mass fraction e)/dt = sum_k A_ke v_k."""
        x = (z * self.elem_scale + self.elem_center) * self.elem_smask
        yp = torch.pow(10.0, x.clamp(max=1.0)) * self.elem_smask     # Y + eps
        a = yp * (math.log(10.0) * self.elem_scale)
        return a.unsqueeze(-1) * self.elem_M

    def conserve_elements(self, z, v):
        """Orthogonal projection (in z) of v onto {A(z) v = 0}: the smallest
        change of the velocity that conserves every element exactly.

        v' = v - A lam,  (A^T A) lam = A^T v.  With A_se = a_s M_se:
            G = A^T A = sum_s a_s^2 M_s M_s^T,   A^T v = M^T (a * v),
            correction_s = a_s (M lam)_s.
        For 3 elements the 3x3 system is solved in closed form (adjugate /
        Cramer, after scaling G to unit diagonal, in float64): a few
        element-wise GPU operations instead of a general solver, which on a GPU
        is slow for tiny systems and synchronizes with the CPU on every call
        (it checks for singular matrices).  Same result up to rounding
        (checked against the float64 general solve: ~1e-6 relative)."""
        if self.elem_M.shape[-1] != 3:
            return self._conserve_elements_general(z, v)
        x = (z * self.elem_scale + self.elem_center) * self.elem_smask
        a = torch.pow(10.0, x.clamp(max=1.0)) * self.elem_smask \
            * (math.log(10.0) * self.elem_scale)                     # [..., S]
        M = self.elem_M                                              # [S, 3]
        MM = (M.unsqueeze(-1) * M.unsqueeze(-2)).reshape(M.shape[0], 9)
        # the 3x3 part runs in float64: only 12 numbers per state, but the
        # system can be nearly singular (e.g. at t = 0 all C and most H sit
        # in CH4), where float32 loses the exactness of the projection
        g = ((a * a) @ MM).double()                                  # [..., 9]
        r = ((a * v) @ M).double()                                   # [..., 3]
        # scale to unit diagonal (Jacobi) -> O(1) entries, then a relative
        # regularization of the diagonal
        dg = torch.stack([g[..., 0], g[..., 4], g[..., 8]], dim=-1).clamp(min=1e-30)
        s_ = torch.rsqrt(dg)                                         # [..., 3]
        s0, s1, s2 = s_[..., 0], s_[..., 1], s_[..., 2]
        eps = 1e-12
        g00 = 1.0 + eps
        g11 = 1.0 + eps
        g22 = 1.0 + eps
        g01 = g[..., 1] * s0 * s1
        g02 = g[..., 2] * s0 * s2
        g12 = g[..., 5] * s1 * s2
        r0, r1, r2 = r[..., 0] * s0, r[..., 1] * s1, r[..., 2] * s2
        c00 = g11 * g22 - g12 * g12
        c01 = g02 * g12 - g01 * g22
        c02 = g01 * g12 - g02 * g11
        c11 = g00 * g22 - g02 * g02
        c12 = g01 * g02 - g00 * g12
        c22 = g00 * g11 - g01 * g01
        det = g00 * c00 + g01 * c01 + g02 * c02
        l0 = (c00 * r0 + c01 * r1 + c02 * r2) / det * s0
        l1 = (c01 * r0 + c11 * r1 + c12 * r2) / det * s1
        l2 = (c02 * r0 + c12 * r1 + c22 * r2) / det * s2
        lam = torch.stack([l0, l1, l2], dim=-1).to(v.dtype)           # [..., 3]
        return v - a * (lam @ M.transpose(0, 1))

    def _conserve_elements_general(self, z, v):
        """Reference implementation (general float64 solve)."""
        A = self.element_matrix_at(z)                                # [..., S, E]
        G = torch.einsum("...se,...sf->...ef", A, A).double()
        rhs = torch.einsum("...se,...s->...e", A, v).double()
        reg = 1e-12 * torch.diagonal(G, dim1=-2, dim2=-1).sum(-1, keepdim=True) + 1e-300
        eye = torch.eye(G.shape[-1], dtype=G.dtype, device=G.device)
        lam = torch.linalg.solve(G + reg.unsqueeze(-1) * eye, rhs.unsqueeze(-1))
        return v - torch.einsum("...se,...e->...s", A, lam.squeeze(-1).to(v.dtype))

    def load_state_dict(self, state_dict, strict=True, **kw):
        out = super().load_state_dict(state_dict, strict=strict, **kw)
        was = self._elem_on
        self._elem_on = bool(self.elem_on.item() > 0.5)
        if self._elem_on != was:
            # the checkpoint decides: a model is always evaluated with the
            # projection setting it was trained with (the start-up line
            # "projection ON/OFF" shows this script's own setting, not the model's)
            print(f"note: the loaded model was trained with the element projection "
                  f"{'ON' if self._elem_on else 'OFF'} -- it is used "
                  f"{'WITH' if self._elem_on else 'WITHOUT'} the projection", flush=True)
        return out


class WindowODE(nn.Module):
    """Wraps RateField for a batch of windows integrated on a shared tau grid.

    tau = (t - t0) / D  in [0, 1] per window, so
        dz/dtau = D * dz/dt = D * F(z, P).
    D is a per-window CONSTANT (a change of integration variable), not a
    network input: the field stays autonomous.
    """

    def __init__(self, field):
        super().__init__()
        self.field = field
        self.p = None      # [B, 1]
        self.D = None      # [B, 1]
        self.nfe = 0

    def set_batch(self, p, D):
        self.p, self.D, self.nfe = p, D, 0

    def forward(self, tau, z):
        self.nfe += 1
        return self.D * self.field.velocity(z, self.p)


field = RateField(n_state, r_init=R_INIT).to(device).to(DTYPE)
ode = WindowODE(field).to(device).to(DTYPE)
n_par = sum(p.numel() for p in field.parameters())
print(f"parameters: {n_par/1e3:.1f}k", flush=True)


def rate_groups_spec(g):
    """g_idx (per kept variable) -> the --rate_groups string that makes it."""
    g = np.asarray(g.cpu() if torch.is_tensor(g) else g).astype(int)
    n = int(g.max()) + 1
    spec = ";".join(",".join(kept_names[k] for k in np.flatnonzero(g == j))
                    for j in range(n - 1))
    return spec or "none"


def adopt_rate_groups(g_ckpt, verbose=True):
    """Make this module use the rate groups a CHECKPOINT was trained with
    (analysis scripts call this before loading a v7 checkpoint, so they do not
    need the --rate_groups flag).  Rebuilds the group targets and, if the number
    of groups differs, the field itself.  Returns True if anything changed."""
    global g_idx, G_IDX, N_GROUPS, GROUP_NAMES, R_LO, R_HI, R_INIT, r_train
    global SPEED, SPEED_C, H_TGT, R_TGT, V_TGT, field, ode, n_par
    global A_SPEED, A_SPEED_C, A_H_TGT, A_R_TGT, A_V_TGT
    g = torch.as_tensor(g_ckpt).to(device).long()
    if g.shape == G_IDX.shape and torch.equal(g, G_IDX):
        return False
    g_idx = g.cpu().numpy()
    G_IDX = g
    N_GROUPS = int(g_idx.max()) + 1
    GROUP_NAMES = ["+".join(kept_names[k] for k in np.flatnonzero(g_idx == j))
                   for j in range(N_GROUPS - 1)] + ["rest"]
    r_train = np.log(np.minimum(group_speed(v_all[train_idx]), SPEED_CAP))
    R_LO = [float(r_train[..., j].min()) - 1.0 - RATE_MARGIN_NATS for j in range(N_GROUPS)]
    R_HI = [float(r_train[..., j].max()) + RATE_MARGIN_NATS for j in range(N_GROUPS)]
    R_INIT = [float(np.median(r_train[..., j])) for j in range(N_GROUPS)]
    SPEED, SPEED_C, H_TGT, R_TGT, V_TGT = _targets(V)
    if AZ is not None:
        A_SPEED, A_SPEED_C, A_H_TGT, A_R_TGT, A_V_TGT = _targets(AV)
    field = RateField(n_state, r_lo=R_LO, r_hi=R_HI, r_init=R_INIT).to(device).to(DTYPE)
    ode = WindowODE(field).to(device).to(DTYPE)
    n_par = sum(p_.numel() for p_ in field.parameters())
    if verbose:
        print(f"rate groups taken from the checkpoint: --rate_groups "
              f"\"{rate_groups_spec(g_idx)}\" ({N_GROUPS} groups)", flush=True)
    return True


# ----------------------------------------------------------------------------
# 4. BATCHED WINDOW SOLVE ON THE TRUE SAMPLE TIMES
# ----------------------------------------------------------------------------

def integrate_windows(z0, p, D, taus, rtol=RTOL_TRAIN, atol=ATOL_TRAIN,
                      max_steps=MAX_STEPS_TRAIN, impl=None, method="dopri5",
                      options=None, max_total_evals=None):
    """z0 [B,S], p [B,1], D [B,1], taus [B,K] (increasing, taus[:,0]==0).

    -> (pred [B,K,S], failed [B] bool).  Every window is integrated on ITS OWN
    true sample times; nothing is resampled onto a uniform grid, and there is
    no clamp on dz/dtau.
    """
    impl = impl or SOLVER_IMPL
    if impl == "custom":
        def f(tau, z, idx):
            ode.nfe += 1
            return D[idx] * field_velocity(z, p[idx])
        ode.nfe = 0
        return odeint_per_sample(f, z0, taus, rtol=rtol, atol=atol,
                                 max_steps=max_steps,
                                 max_total_evals=max_total_evals)
    # --- torchdiffeq reference path: one shared grid (union of all taus) ----
    B, K = taus.shape
    grid, inverse = torch.unique(taus.reshape(-1), sorted=True, return_inverse=True)
    ode.set_batch(p, D)
    opts = {"max_num_steps": max_steps} if options is None else options
    sol = odeint(ode, z0, grid, method=method, rtol=rtol, atol=atol, options=opts)
    idx = inverse.view(B, K)
    batch_ar = torch.arange(B, device=taus.device).unsqueeze(1).expand(B, K)
    pred = sol[idx, batch_ar, :]
    failed = ~torch.isfinite(pred).all(dim=(1, 2))
    return pred, failed


_VEL_COMPILED = {}


def field_velocity(z, p):
    """The model call the ODE solver makes: field.velocity, compiled with
    torch.compile when COMPILE_FIELD is on.  dynamic=True: the per-sample
    solver calls it with a different number of active samples at every step."""
    global COMPILE_FIELD
    if not COMPILE_FIELD:
        return field.velocity(z, p)
    key = id(field)
    fn = _VEL_COMPILED.get(key)
    if fn is None:
        fn = torch.compile(field.velocity, dynamic=True)
        _VEL_COMPILED[key] = fn
        try:
            out = fn(z, p)
            print("compile_field: model call compiled", flush=True)
            return out
        except Exception as exc:                                   # noqa: BLE001
            print(f"compile_field: compiling failed ({type(exc).__name__}: "
                  f"{str(exc)[:150]}) -- continuing without it", flush=True)
            COMPILE_FIELD = False
            return field.velocity(z, p)
    return fn(z, p)


def solver_self_test(n_windows=8, length=50):
    """Cross-check the per-sample solver against torchdiffeq on this model."""
    g = torch.Generator(device=device); g.manual_seed(0)
    ci, st = sample_windows(train_t, length, n_windows, g)
    z0, p, D, taus, z_true, _, _, _ = make_window_batch(ci, st, length)
    a, fa = integrate_windows(z0, p, D, taus, 1e-8, 1e-10, 200000, impl="custom")
    b, fb = integrate_windows(z0, p, D, taus, 1e-8, 1e-10, 200000, impl="torchdiffeq")
    la = ((a - z_true) ** 2).mean(); lb = ((b - z_true) ** 2).mean()
    ga = torch.autograd.grad(la, list(field.parameters()))
    gb = torch.autograd.grad(lb, list(field.parameters()))
    num = sum(((x - y) ** 2).sum() for x, y in zip(ga, gb)).sqrt()
    den = sum((y ** 2).sum() for y in gb).sqrt()
    print(f"solver self-test: max|custom - torchdiffeq| = "
          f"{(a - b).abs().max().item():.2e} | relative gradient difference = "
          f"{float(num / den.clamp(min=1e-30)):.2e} | failed {int(fa.sum())}/"
          f"{int(fb.sum())}", flush=True)


def make_window_batch(case_ids, starts, length):
    """Gather a batch of windows -> (z0, p, D, taus, z_true, v_true)."""
    K = length
    offs = torch.arange(K, device=device)
    rows = case_ids.unsqueeze(1)
    cols = starts.unsqueeze(1) + offs.unsqueeze(0)
    t = TT[rows, cols]                       # [B,K]
    z = Z[rows, cols]                        # [B,K,S]
    v = V[rows, cols]
    t0 = t[:, :1]
    D = (t[:, -1:] - t0)
    taus = ((t - t0) / D).to(DTYPE)
    D = D.to(DTYPE)
    p = PP[case_ids].unsqueeze(-1)
    return z[:, 0], p, D, taus, z, v, rows, cols


# ----------------------------------------------------------------------------
# 5. LOSSES
# ----------------------------------------------------------------------------

LOSS_PARTS = {}      # last batch's loss components, for the epoch printout


def _default_loss_cfg():
    return dict(traj_loss=TRAJ_LOSS, huber_delta=TRAJ_HUBER_DELTA,
                majors_y_weight=MAJORS_Y_WEIGHT, noise=NOISE_STD_Z0,
                lambda_deriv=LAMBDA_DERIV_IN_STAGES)


def majors_mass_fraction(z):
    """normalized z [..., S] -> mass fractions of MAJOR_SPECIES [..., M]."""
    x = z[..., MAJ_Z_IDX] * MAJ_SCALE + MAJ_CENTER
    return torch.pow(10.0, x) - LOG_EPS


def trajectory_loss(pred, true, ok=None, cfg=None):
    """Weighted trajectory loss in normalized state space, skipping the
    (exact) t0 point, plus optionally the majors mass-fraction term.

    cfg["traj_loss"]: "huber" (delta = cfg["huber_delta"]) or "mse"
    (0.5 * err^2: the same as Huber for small errors, without the linear cap).
    `ok` masks out windows the solver could not finish -- those contribute no
    gradient instead of taking the whole batch down (the old code replaced a
    failed window with a constant penalty, whose gradient is zero anyway, and
    dropped the entire batch on a solver exception).
    """
    cfg = cfg or _default_loss_cfg()
    if cfg["traj_loss"] == "mse":
        e = 0.5 * (pred[:, 1:] - true[:, 1:]) ** 2
    else:
        e = torch.nn.functional.huber_loss(
            pred[:, 1:], true[:, 1:], delta=cfg["huber_delta"], reduction="none")
    err = (e * CHW).mean(dim=(1, 2))
    w_y = cfg.get("majors_y_weight", 0.0)
    if w_y > 0 and len(MAJ_Z_IDX):
        ly = ((majors_mass_fraction(pred[:, 1:])
               - majors_mass_fraction(true[:, 1:])) ** 2).mean(dim=(1, 2))
    else:
        ly = torch.zeros_like(err)
    if ok is not None:
        if not bool(ok.any()):
            raise RuntimeError("every window in the batch failed to integrate")
        err, ly = err[ok], ly[ok]
    LOSS_PARTS["state"] = float(err.mean().detach())
    LOSS_PARTS["majors_y"] = float(ly.mean().detach())
    return err.mean() + w_y * ly.mean()


def derivative_loss(z, p, v_tgt, speed, r_tgt, h_tgt):
    """Collocation loss at TRUE states.

    The velocity error is measured RELATIVE to the local speed, which is the
    only scale-free way to supervise a field spanning ~16 decades, and --
    unlike supervising ln|v| and v/|v| separately -- it has no coordinate
    singularity at the equilibrium fixed point (where |v| -> 0 but the state
    stops moving, so ln|v| is not a Lipschitz function of z).
    """
    r, h = field(z, p)
    # direction part: MSE against v / S, with S = sqrt(|v|^2 + VELOCITY_FLOOR^2).
    # The floor makes h* -> 0 smoothly as the trajectory reaches equilibrium,
    # so "at rest" is the model's default there instead of an unlearnable,
    # singular log-rate.
    l_dir = (((h - h_tgt) ** 2) * CHW).mean()
    # rate part: HUBER in nats.  Near the fixed point, ln|v| ~ ln|z - z_eq| is
    # genuinely not a Lipschitz function of z (measured: local Lipschitz up to
    # 6e8 in the equilibrium tail), so a few nats of irreducible error live
    # there; Huber stops those points from dominating the gradient.  They are
    # physically harmless: an over- or under-predicted relaxation rate at a
    # state already within ~1e-5 of equilibrium only changes how fast the
    # model settles onto the same fixed point.
    # v7: one Huber term per rate group, averaged over the groups
    l_rate = torch.nn.functional.huber_loss(r, r_tgt, delta=HUBER_DELTA_RATE)
    v = torch.exp(r)[..., G_IDX] * h
    rel = ((v - v_tgt).norm(dim=-1) / speed).detach()
    return (W_DIR * l_dir + W_RATE * l_rate, l_dir.detach(), l_rate.detach(), rel)


# ----------------------------------------------------------------------------
# 6. PRETRAINING (pure derivative matching -- gives the shooting stages a
#    field that is already the right order of magnitude everywhere)
# ----------------------------------------------------------------------------

PRETRAIN_CKPT = OUT_DIR / "pretrain_best.pt"


def pretrain():
    if PRETRAIN_CKPT.exists():
        ck = torch.load(PRETRAIN_CKPT, map_location=device, weights_only=False)
        g_ck = ck["model"].get("g_idx")
        if g_ck is not None and not (g_ck.shape == G_IDX.shape
                                     and torch.equal(g_ck.to(device), G_IDX)):
            sys.exit(f"error: {PRETRAIN_CKPT} was trained with --rate_groups "
                     f"\"{rate_groups_spec(g_ck)}\", this run uses "
                     f"\"{rate_groups_spec(G_IDX)}\".  Pass the same --rate_groups "
                     f"as for pretraining (or use a new --out_dir).")
        sd_ck = dict(ck["model"])
        own = field.state_dict()
        added = [k for k in own if k.startswith("elem_") and k not in sd_ck]
        for k in added:                 # a v7 pretraining: same network, same loss
            sd_ck[k] = own[k]
        field.load_state_dict(sd_ck)
        print(f"loaded pretrained field (val {ck['val']:.4e})"
              + (" -- weights from a v7 run (pretraining is identical in v7 and v8); "
                 "element buffers built from this run's data" if added else ""),
              flush=True)
        return
    opt = torch.optim.AdamW(field.parameters(), lr=PRETRAIN_LR, weight_decay=1e-6)
    sched = torch.optim.lr_scheduler.CosineAnnealingLR(
        opt, T_max=PRETRAIN_STEPS, eta_min=PRETRAIN_LR_MIN)

    def gather(idx_tensor, n):
        n_aug = int(n * AUG_FRACTION) if AZ is not None else 0
        n_dat = n - n_aug
        ci = idx_tensor[torch.randint(len(idx_tensor), (n_dat,), device=device)]
        ti = torch.randint(n_points, (n_dat,), device=device)
        out = [Z[ci, ti], PP[ci].unsqueeze(-1), V_TGT[ci, ti], SPEED_C[ci, ti],
               R_TGT[ci, ti], H_TGT[ci, ti]]
        if n_aug:
            cj = idx_tensor[torch.randint(len(idx_tensor), (n_aug,), device=device)]
            tj = torch.randint(n_aug_points, (n_aug,), device=device)
            aug = [AZ[cj, tj], PP[cj].unsqueeze(-1), A_V_TGT[cj, tj],
                   A_SPEED_C[cj, tj], A_R_TGT[cj, tj], A_H_TGT[cj, tj]]
            out = [torch.cat([a, b], dim=0) for a, b in zip(out, aug)]
        return tuple(out)

    best, best_state = float("inf"), copy.deepcopy(field.state_dict())
    t0 = time.time()
    for step in range(1, PRETRAIN_STEPS + 1):
        field.train()
        loss, ldir, lrate, _ = derivative_loss(*gather(train_t, PRETRAIN_BATCH))
        opt.zero_grad(set_to_none=True)
        loss.backward()
        nn.utils.clip_grad_norm_(field.parameters(), GRAD_CLIP)
        opt.step()
        sched.step()
        if step % PRETRAIN_EVAL_EVERY == 0 or step == PRETRAIN_STEPS:
            field.eval()
            with torch.no_grad():
                vloss, vdir, vrate, rel = derivative_loss(*gather(val_t, 8192))
                n_d = 8192 - (int(8192 * AUG_FRACTION) if AZ is not None else 0)
                rel_data, rel_aug = rel[:n_d], rel[n_d:]
            if vloss.item() < best:
                best = vloss.item()
                best_state = copy.deepcopy(field.state_dict())
            print(f"  pretrain {step:7d}/{PRETRAIN_STEPS} | train {loss.item():.4e} "
                  f"| val {vloss.item():.4e} (dir {vdir:.3e}, rate {vrate:.3e}) "
                  f"| rel. velocity error on data: median "
                  f"{100*rel_data.median():.1f}% p90 "
                  f"{100*torch.quantile(rel_data, 0.9):.1f}%"
                  + (f" | augmented: median {100*rel_aug.median():.1f}%"
                     if rel_aug.numel() else "") + " "
                  f"| lr {sched.get_last_lr()[0]:.2e} | {time.time()-t0:.0f}s", flush=True)
    field.load_state_dict(best_state)
    torch.save({"model": best_state, "val": best}, PRETRAIN_CKPT)
    print(f"pretraining done (best val {best:.4e})", flush=True)


@torch.no_grad()
def pretrain_report(split):
    """Relative velocity error |F(z,P) - v_true| / |v_true| of the current
    field at EVERY sample point of every case in `split` (deterministic, unlike
    the random 8192-point check during pretraining), split at the ignition
    point (first crossing of half the temperature rise).  The t = 0 point is
    left out (its target rate is capped, see SPEED_CAP).  This measures how
    well the network can represent the true field -- the quantity to compare
    between network sizes."""
    field.eval()
    idx = {"train": train_idx, "val": val_idx, "test": test_idx}[split]
    rel_all, post_all, relp_all = [], [], []
    for c in idx:
        c = int(c)
        T = states_phys[c, :, 0]
        i_ign = int(np.flatnonzero(T >= T[0] + 0.5 * (T.max() - T[0]))[0])
        p = PP[c].reshape(1, 1).expand(n_points, 1)
        _, _, _, rel = derivative_loss(Z[c], p, V_TGT[c], SPEED_C[c], R_TGT[c], H_TGT[c])
        rel_all.append(rel.cpu().numpy()[1:])
        post_all.append((np.arange(n_points) >= i_ign)[1:])
        # v8: the velocity the solver actually integrates (box gate + projection)
        vp = field.velocity(Z[c], p)
        relp_all.append(((vp - V_TGT[c]).norm(dim=-1) / SPEED_C[c]).cpu().numpy()[1:])
    rel, post = np.concatenate(rel_all), np.concatenate(post_all)
    relp = np.concatenate(relp_all)
    print(f"  {split:5s} integrated velocity (gate{' + element projection' if field._elem_on else ''}):"
          f" median {100*np.median(relp):6.2f}% | p90 {100*np.percentile(relp, 90):7.2f}%"
          f" (raw network: median {100*np.median(rel):6.2f}% | p90 "
          f"{100*np.percentile(rel, 90):7.2f}%)", flush=True)

    def q(a):
        return {"median": float(np.median(a)), "p90": float(np.percentile(a, 90)),
                "p99": float(np.percentile(a, 99))}
    out = {"all": q(rel), "before_ignition": q(rel[~post]),
           "after_ignition": q(rel[post]), "n_points": int(len(rel))}
    for k in ("all", "before_ignition", "after_ignition"):
        m = out[k]
        print(f"  {split:5s} {k:16s}: median {100*m['median']:6.2f}% | p90 "
              f"{100*m['p90']:7.2f}% | p99 {100*m['p99']:8.2f}%", flush=True)
    return out


# ----------------------------------------------------------------------------
# 7. ROLLOUTS AND METRICS (evaluated at the TRUE sample times)
# ----------------------------------------------------------------------------

def _solve_case(case_id, t_idx_from, t_idx_to, z0, rtol, atol, max_steps,
                impl=None):
    t = TT[case_id, t_idx_from:t_idx_to]
    D = (t[-1] - t[0]).reshape(1, 1).to(DTYPE)
    taus = ((t - t[0]) / (t[-1] - t[0])).reshape(1, -1).to(DTYPE)
    p = PP[case_id].reshape(1, 1)
    z, failed = integrate_windows(z0.reshape(1, -1), p, D, taus, rtol=rtol,
                                  atol=atol, max_steps=max_steps, impl=impl)
    if bool(failed[0]):
        raise RuntimeError("integration did not finish")
    return z[0]


@torch.no_grad()
def continuous_rollout(case_id, allow_fallback=True, max_steps=None):
    """ONE integration over the whole trajectory, from the true state at t=0,
    evaluated at the case's own true sample times."""
    field.eval()
    try:
        z = _solve_case(case_id, 0, n_points, Z[case_id, 0],
                        RTOL_EVAL, ATOL_EVAL, max_steps or MAX_STEPS_EVAL)
        if torch.isfinite(z).all():
            return z.cpu().numpy(), SOLVER_IMPL
        raise RuntimeError("non-finite")
    except Exception as exc:
        if not allow_fallback:
            return None, "failed"
        # stiff fallback: implicit LSODA, forward only (no gradients needed)
        try:
            ode.set_batch(PP[case_id].reshape(1, 1),
                          (TT[case_id, -1] - TT[case_id, 0]).reshape(1, 1).to(DTYPE))
            t = TT[case_id]
            taus = ((t - t[0]) / (t[-1] - t[0])).to(DTYPE)
            z = odeint(ode, Z[case_id, 0].reshape(1, -1), taus,
                       method="scipy_solver", rtol=RTOL_EVAL, atol=ATOL_EVAL,
                       options={"solver": "LSODA"})[:, 0]
            return z.cpu().numpy(), "LSODA"
        except Exception as exc2:
            print(f"    rollout failed for case {int(case_id)}: {exc} / {exc2}",
                  flush=True)
            return None, "failed"


@torch.no_grad()
def reset_rollout(case_id, window_len, overlap):
    """Window-by-window, each window restarted from the TRUE state at its own
    start index, evaluated at the true sample times."""
    field.eval()
    bounds, s = [], 0
    while s < n_points - 1:
        e = min(s + window_len, n_points)
        if e == n_points and (e - s) < 2 and bounds:
            bounds[-1] = (bounds[-1][0], e)
            break
        bounds.append((s, e))
        if e == n_points:
            break
        s = e - overlap
    out = np.empty((n_points, n_state))
    out[:] = np.nan
    for (a, b) in bounds:
        try:
            z = _solve_case(case_id, a, b, Z[case_id, a],
                            RTOL_EVAL, ATOL_EVAL, MAX_STEPS_EVAL).cpu().numpy()
        except Exception as exc:
            print(f"    reset window [{a},{b}) failed: {type(exc).__name__}", flush=True)
            continue
        out[a:b] = z
    return out


def case_metrics(case_id, z_pred):
    """Physical-unit metrics on one case."""
    if z_pred is None or not np.isfinite(z_pred).all():
        return None
    t = times_phys[case_id]
    true = states_phys[case_id]
    pred = z_to_physical(z_pred, case_id)
    T_err = pred[:, 0] - true[:, 0]

    def t_ign(Tc):
        """Ignition time = first crossing of half the total temperature rise.

        Deliberately NOT argmax(dT/dt): on a reset rollout the largest dT/dt
        can sit on the jump at a window boundary rather than on the ignition
        front, which made that metric meaningless (it swung between 0.3% and
        87% between epochs while the trajectories barely changed).
        """
        half = Tc[0] + 0.5 * (Tc.max() - Tc[0])
        idx = np.flatnonzero(Tc >= half)
        return t[idx[0]] if len(idx) else t[-1]
    ti_t, ti_p = t_ign(true[:, 0]), t_ign(pred[:, 0])
    m = {
        "T_rmse": float(np.sqrt(np.mean(T_err ** 2))),
        "T_max": float(np.abs(T_err).max()),
        "t_ign_rel": float(abs(ti_p - ti_t) / max(ti_t, 1e-30)),
    }
    # species: factor error where the species is above the metric floor
    Yt, Yp = true[:, 1:], pred[:, 1:]
    mask = Yt > SPECIES_METRIC_FLOOR
    if mask.any():
        dl = np.abs(np.log10((Yp + LOG_EPS) / (Yt + LOG_EPS)))[mask]
        m["Y_factor_median"] = float(10 ** np.median(dl))
        m["Y_factor_p90"] = float(10 ** np.percentile(dl, 90))
    else:
        m["Y_factor_median"] = m["Y_factor_p90"] = float("nan")
    majors = [s for s in ["CH4", "O2", "CO", "H2", "CO2", "H2O"] if s in species_names]
    ix = [species_names.index(s) for s in majors]
    m["Y_major_rmse"] = float(np.sqrt(np.mean((Yp[:, ix] - Yt[:, ix]) ** 2)))
    # v8: largest relative element drift along the rollout (C, H, O), %
    b = Yp @ M_full
    b0 = Yt[0] @ M_full
    m["elem_drift_pct"] = float(100 * np.max(np.abs(b - b0) / np.maximum(b0, 1e-30)))
    return m


def summarize(ms, label):
    n_all = len(ms)
    ms = [m for m in ms if m is not None]
    if not ms:
        print(f"  {label}: all {n_all} rollouts FAILED (step cap or non-finite)",
              flush=True)
        return {}
    agg = {k: float(np.mean([m[k] for m in ms])) for k in ms[0]}
    print(f"  {label}: T_rmse {agg['T_rmse']:7.2f} K | T_max {agg['T_max']:7.1f} K "
          f"| t_ign err {100*agg['t_ign_rel']:5.1f}% | Y factor (median) "
          f"{agg['Y_factor_median']:.2f}x | majors RMSE {agg['Y_major_rmse']:.2e}"
          + (f" | element drift (max along rollout) {agg['elem_drift_pct']:.2g}%" if "elem_drift_pct" in agg
             else "")
          + f" | {len(ms)} case(s)"
          + (f" | {n_all - len(ms)} FAILED (step cap)" if n_all > len(ms) else ""),
          flush=True)
    return agg



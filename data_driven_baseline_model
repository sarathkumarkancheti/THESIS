_STAGE_FIELDS = {"window": "int_or_none", "epochs": "int", "per_epoch": "int_or_none",
                 "batch": "int", "lr_max": "float", "lr_min": "float",
                 "from_start": "float", "traj_loss": "str", "huber_delta": "float",
                 "majors_y_weight": "float", "noise": "float",
                 "lambda_deriv": "float"}


def _build_stages(stages):
    out = []
    for s in stages:
        d = dict(zip(["name", "window", "epochs", "per_epoch", "batch", "lr_max",
                      "lr_min", "from_start"], s[:8]))
        d.update(dict(traj_loss=TRAJ_LOSS, huber_delta=TRAJ_HUBER_DELTA,
                      majors_y_weight=MAJORS_Y_WEIGHT, noise=NOISE_STD_Z0,
                      lambda_deriv=LAMBDA_DERIV_IN_STAGES))
        if len(s) > 8:
            d.update(s[8])
        out.append(d)
    names = [d["name"] for d in out]
    for spec in _RAW.get("stage", []):
        try:
            lhs, val = str(spec).split("=", 1)
            nm, fld = lhs.split(".", 1)
        except ValueError:
            sys.exit(f"error: --stage expects NAME.FIELD=VALUE, got {spec!r}")
        if nm not in names:
            sys.exit(f"error: --stage: no stage {nm!r} (stages: {names})")
        if fld not in _STAGE_FIELDS:
            sys.exit(f"error: --stage: unknown field {fld!r} "
                     f"(fields: {list(_STAGE_FIELDS)})")
        v = _convert(val, _STAGE_FIELDS[fld])
        if fld == "traj_loss" and v not in ("huber", "mse"):
            sys.exit("error: traj_loss must be huber or mse")
        out[names.index(nm)][fld] = v
        print(f"stage {nm}: {fld} = {v}", flush=True)
    stop = _RAW.get("stop_after", [None])[-1]
    if stop == "pretrain":
        return []
    if stop is not None:
        if stop not in names:
            sys.exit(f"error: --stop_after: no stage {stop!r} (stages: {names})")
        out = out[:names.index(stop) + 1]
    return out



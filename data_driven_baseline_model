def _cli_active():
    main = sys.modules.get("__main__")
    return __name__ == "__main__" or bool(getattr(main, "NODE_FORWARD_CLI", False))


def _prescan(argv):
    """--key value / --key=value / bare --key  ->  {key: [values...]}"""
    raw, i = {}, 0
    while i < len(argv):
        a = argv[i]
        if a.startswith("--") and len(a) > 2:
            key, eq, val = a[2:].partition("=")
            key = key.replace("-", "_").lower()
            if key.startswith("node_"):
                key = key[5:]
            if not eq:
                if i + 1 < len(argv) and not argv[i + 1].startswith("--"):
                    val = argv[i + 1]
                    i += 1
                else:
                    val = None
            raw.setdefault(key, []).append(val)
        i += 1
    return raw


_ARGV = sys.argv[1:] if _cli_active() else []
_RAW = _prescan(_ARGV)
_SETTINGS = {}          # key -> metadata, in definition order
_GROUP = ["general"]


def _group(name):
    _GROUP[0] = name


def _to_bool(s):
    s = str(s).strip().lower()
    if s in ("1", "true", "yes", "on", "y", "t"):
        return True
    if s in ("0", "false", "no", "off", "n", "f"):
        return False
    raise ValueError(f"not a boolean: {s!r}")


def _convert(s, kind):
    if kind == "bool":
        return _to_bool(s)
    if kind.endswith("_or_none"):
        if str(s).strip().lower() in ("none", "null", "off"):
            return None
        kind = kind[:-8]
    if kind == "int":
        return int(float(s))
    if kind == "float":
        return float(s)
    if kind == "path":
        return Path(s)
    if kind == "list":
        return [x.strip() for x in str(s).split(",") if x.strip()]
    return str(s)


def setting(name, default, kind=None, choices=None, env=None, help=""):
    """Register a setting and return its value (flag > env > default)."""
    if kind is None:
        kind = {bool: "bool", int: "int", float: "float", str: "str",
                list: "list"}.get(type(default), "path" if isinstance(default, Path)
                                   else "str")
    key = name.lower()
    _SETTINGS[key] = dict(name=name, default=default, kind=kind, choices=choices,
                          help=help, group=_GROUP[0])
    value, source = default, "default"
    for ev in [f"NODE_{name}"] + ([env] if env else []):
        if os.environ.get(ev) not in (None, ""):
            value, source = os.environ[ev], f"environment variable {ev}"
    if key in _RAW:
        value, source = _RAW[key][-1], f"flag --{key}"
        if value is None:
            if kind != "bool":
                sys.exit(f"error: --{key} needs a value")
            value = "true"
    if source != "default":
        try:
            value = _convert(value, kind)
        except ValueError as exc:
            sys.exit(f"error: {source}: {exc}")
    if choices is not None and value not in choices:
        sys.exit(f"error: {name} must be one of {choices}, got {value!r}")
    _SETTINGS[key]["value"] = value
    return value


def _finish_cli():
    """--help, unknown-flag check, and a list of what was changed."""
    rows = ["stages (values at batch_scale 1; change with --stage NAME.FIELD=VALUE):",
            f"  {'name':6s} {'window':>6s} {'epochs':>6s} {'per_epoch':>9s} "
            f"{'batch':>5s} {'lr_max':>8s} {'lr_min':>8s} {'from_start':>10s}  other"]
    for st_ in STAGES:
        w = "full" if st_[1] is None else st_[1]
        pe = "all" if st_[3] is None else st_[3]
        other = (", ".join(f"{k}={v}" for k, v in st_[8].items())
                 if len(st_) > 8 else "")
        rows.append(f"  {st_[0]:6s} {w!s:>6s} {st_[2]:>6d} {pe!s:>9s} {st_[4]:>5d} "
                    f"{st_[5]:>8.1e} {st_[6]:>8.1e} {st_[7]:>10.2f}  {other}")
    ap = argparse.ArgumentParser(
        epilog="\n".join(rows), formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Autonomous rate-field NODE -- every setting is a flag. "
                    "Precedence: flag > NODE_<NAME> environment variable > default.",
        usage="python train_node_rate_field_v4.py [--flag value ...]   "
              "(see below; --node_<flag> works too)",
        allow_abbrev=False)
    groups = {}
    for key, s in _SETTINGS.items():
        g = groups.get(s["group"]) or ap.add_argument_group(s["group"])
        groups[s["group"]] = g
        d = s["default"]
        d = ",".join(d) if isinstance(d, list) else d
        extra = f" {s['choices']}" if s["choices"] else ""
        g.add_argument(f"--{key}", f"--node_{key}", dest=key, metavar="V",
                       nargs="?" if s["kind"] == "bool" else None,
                       help=f"{s['help']}{extra} (default: {d})")
    g = groups.get("curriculum") or ap.add_argument_group("curriculum")
    g.add_argument("--stage", action="append", metavar="NAME.FIELD=VALUE",
                   help="change one field of one stage, repeatable "
                        "(e.g. --stage full.epochs=150)")
    g.add_argument("--stop_after", "--node_stop_after", metavar="NAME",
                   help="run the curriculum up to and including this stage; "
                        "'pretrain' = only pretraining + a derivative-accuracy "
                        "report (e.g. to compare network sizes)")
    known = set(_SETTINGS) | {"stage", "stop_after", "help"}
    for k in _RAW:
        if k not in known:
            hint = difflib.get_close_matches(k, known, n=1)
            sys.exit(f"error: unknown flag --{k}"
                     + (f" (did you mean --{hint[0]}?)" if hint else "")
                     + "   -- see --help")
    ap.parse_args(_ARGV)          # prints --help, checks the remaining syntax
    changed = [f"{s['name']}={s['value']}" for s in _SETTINGS.values()
               if s["value"] != s["default"]]
    if changed:
        print("settings changed from the defaults: " + ", ".join(changed), flush=True)



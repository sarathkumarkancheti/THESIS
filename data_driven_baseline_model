# 8. MULTIPLE-SHOOTING STAGES
# ----------------------------------------------------------------------------

def sample_windows(case_pool, length, n, generator, from_start=0.0):
    """`from_start` is the FRACTION of windows anchored at t=0.

    Prefix windows (anchored at t=0) are what actually train the continuous
    rollout: a long rollout accumulates its timing error in the induction
    phase, which is only ever entered from the true initial state.  But a
    stage made of prefix windows ALONE forgets the rest of the trajectory --
    measured: 6 epochs of pure prefix-60 training took the reset-rollout
    ignition error from 0.7% to 37.9%.  Mixing is what works.
    """
    ci = case_pool[torch.randint(len(case_pool), (n,), device=device,
                                 generator=generator)]
    st = torch.randint(n_points - length + 1, (n,), device=device,
                       generator=generator)
    if from_start > 0:
        anchor = torch.rand(n, device=device, generator=generator) < from_start
        st = torch.where(anchor, torch.zeros_like(st), st)
    return ci, st


def run_batch(ci, st, length, noise=0.0, cfg=None):
    """One batch of windows -> (total loss, trajectory loss, collocation loss,
    number of failed windows).  `cfg`: the stage's loss settings."""
    cfg = cfg or _default_loss_cfg()
    lam = cfg.get("lambda_deriv", LAMBDA_DERIV_IN_STAGES)
    z0, p, D, taus, z_true, v_true, rows, cols = make_window_batch(ci, st, length)
    if noise > 0:
        dz = noise * torch.randn_like(z0)
        if not NOISE_AT_T0:
            dz = dz * (st > 0).unsqueeze(-1).to(dz.dtype)
        z0 = z0 + dz
    pred, failed = integrate_windows(z0, p, D, taus,
                                     max_total_evals=EVAL_BUDGET_TRAIN)
    ok = (~failed) & torch.isfinite(pred).all(dim=(1, 2))
    l_traj = trajectory_loss(pred, z_true, ok, cfg)
    if lam > 0:
        args = [z_true.reshape(-1, n_state),
                p.unsqueeze(1).expand(-1, length, -1).reshape(-1, 1),
                V_TGT[rows, cols].reshape(-1, n_state),
                SPEED_C[rows, cols].reshape(-1),
                R_TGT[rows, cols].reshape(-1, N_GROUPS),
                H_TGT[rows, cols].reshape(-1, n_state)]
        if AZ is not None and AUG_FRACTION > 0:
            m = args[0].shape[0]
            n_aug = max(1, int(m * AUG_FRACTION))
            cj = ci[torch.randint(len(ci), (n_aug,), device=device)]
            tj = torch.randint(n_aug_points, (n_aug,), device=device)
            aug = [AZ[cj, tj], PP[cj].unsqueeze(-1), A_V_TGT[cj, tj],
                   A_SPEED_C[cj, tj], A_R_TGT[cj, tj], A_H_TGT[cj, tj]]
            args = [torch.cat([a, b], dim=0) for a, b in zip(args, aug)]
        l_der, _, _, _ = derivative_loss(*args)
    else:
        l_der = torch.zeros((), dtype=DTYPE, device=device)
    return (l_traj + lam * l_der, l_traj.detach(),
            l_der.detach(), int((~ok).sum()))


class StageCosineLR:
    """Cosine decay lr_max -> lr_min over a stage, in closed form.

    Written out instead of torch's CosineAnnealingLR for two reasons:
    (1) torch's schedule is PERIODIC past its end, so resuming a stage after
        changing its epoch count sends the learning rate back UP;
    (2) the rollback needs to halve the rate permanently, which a recursive
        scheduler does not do cleanly.
    Reads old checkpoints written with CosineAnnealingLR (uses `last_epoch`).
    """

    def __init__(self, opt, lr_max, lr_min, total_steps):
        self.opt, self.lr_max, self.lr_min = opt, lr_max, lr_min
        self.total = max(1, int(total_steps))
        self.step_i, self.scale = 0, 1.0
        # v7: optional linear warm-up (STAGE_WARMUP_FRACTION), restarted after
        # a rollback because that resets the Adam moments as well
        self.warm = int(round(STAGE_WARMUP_FRACTION * self.total))
        self.warm_start = 0
        self._apply()

    def _lr(self):
        f = min(self.step_i / self.total, 1.0)
        lr = self.scale * (self.lr_min + 0.5 * (self.lr_max - self.lr_min)
                           * (1.0 + math.cos(math.pi * f)))
        if self.warm > 0:
            lr *= min(1.0, (self.step_i - self.warm_start + 1) / self.warm)
        return lr

    def _apply(self):
        for g in self.opt.param_groups:
            g["lr"] = self._lr()

    def step(self):
        self.step_i += 1
        self._apply()

    def halve(self):
        self.scale *= 0.5
        self.warm_start = self.step_i
        self._apply()

    def get_last_lr(self):
        return [self._lr()]

    def state_dict(self):
        return {"step_i": self.step_i, "scale": self.scale,
                "warm_start": self.warm_start}

    def load_state_dict(self, d):
        self.step_i = int(d.get("step_i", d.get("last_epoch", 0)))
        self.scale = float(d.get("scale", 1.0))
        # a resumed stage does not warm up again
        self.warm_start = int(d.get("warm_start", -10 ** 9))
        self._apply()


def train_stage(stage):
    """Train one curriculum stage.  `stage`: one entry of STAGES (a dict)."""
    name, length, epochs = stage["name"], stage["window"], stage["epochs"]
    per_epoch, batch = stage["per_epoch"], stage["batch"]
    lr_max, lr_min, from_start = stage["lr_max"], stage["lr_min"], stage["from_start"]
    cfg = {k: stage[k] for k in ("traj_loss", "huber_delta", "majors_y_weight",
                                 "noise", "lambda_deriv")}
    use_y = cfg["majors_y_weight"] > 0
    full = length is None
    if full:
        from_start = 1.0
    L = n_points if full else length
    if full:
        per_epoch = len(train_idx)
    stage_dir = OUT_DIR / name
    stage_dir.mkdir(parents=True, exist_ok=True)
    latest = stage_dir / "latest.pt"

    # Effective batch / learning rates.  A stage that has already started
    # keeps exactly the settings it started with (they are stored in its
    # checkpoint), so changing NODE_BATCH_SCALE never alters a stage midway.
    ck = None
    if latest.exists():
        ck = torch.load(latest, map_location=device, weights_only=False)
    if ck is not None and "stage_cfg" in ck:
        batch, lr_max, lr_min = ck["stage_cfg"][:3]
    elif ck is None and BATCH_SCALE != 1.0:
        f = math.sqrt(BATCH_SCALE)
        batch = max(1, int(round(batch * BATCH_SCALE)))
        lr_max, lr_min = min(lr_max * f, LR_CAP), min(lr_min * f, LR_CAP)
        print(f"  (batch scale x{BATCH_SCALE:g}: batch {batch}, lr scaled by "
              f"sqrt = x{f:.2f})", flush=True)
    if ck is not None and "stage_cfg" in ck and len(ck["stage_cfg"]) > 3:
        per_epoch = ck["stage_cfg"][3]
    elif ck is None and WINDOWS_SCALE != 1.0 and not full:
        per_epoch = int(round(per_epoch * WINDOWS_SCALE))
        print(f"  (windows per epoch x{WINDOWS_SCALE:g}: {per_epoch})", flush=True)
    stage_cfg = (batch, lr_max, lr_min, per_epoch)
    n_batches = max(1, per_epoch // batch)

    opt = torch.optim.AdamW(field.parameters(), lr=lr_max, weight_decay=1e-6)
    sched = StageCosineLR(opt, lr_max, lr_min, epochs * n_batches)
    start_epoch, best_state = 1, copy.deepcopy(field.state_dict())
    history = []
    # Measure the INCOMING model on this stage's validation windows and use it
    # as the bar to beat.  A stage that cannot improve on the model it was
    # given therefore leaves it untouched, instead of replacing it with its own
    # (worse) best -- measured need for this: a naive full-trajectory stage
    # made reset-rollout ignition error go from 0.7% to 62%.
    best = float("inf")

    if ck is not None:
        field.load_state_dict(ck["model"])
        opt.load_state_dict(ck["opt"])
        sched.load_state_dict(ck["sched"])
        start_epoch, best, best_state = ck["epoch"] + 1, ck["best"], ck["best_state"]
        history = ck["history"]
        if start_epoch > epochs:
            print(f"=== stage {name}: already complete (best {best:.4e}) ===", flush=True)
            field.load_state_dict(best_state)
            return
        print(f"=== stage {name}: resuming at epoch {start_epoch} ===", flush=True)

    print(f"\n=== stage {name} | window {'FULL ('+str(L)+' pts)' if full else L}"
          f"{f' ({from_start:.0%} anchored at t=0)' if from_start and not full else ''} "
          f"| {epochs} epochs x {n_batches} batches of {batch} "
          f"| lr {lr_max:.1e} -> {lr_min:.1e} ===", flush=True)
    loss_txt = ("mse" if cfg["traj_loss"] == "mse"
                else f"huber(delta {cfg['huber_delta']:g})")
    y_txt = (f" + {cfg['majors_y_weight']:g} x majors mass-fraction MSE"
             if use_y else "")
    print(f"  loss: trajectory {loss_txt}{y_txt} + {cfg['lambda_deriv']:g} x "
          f"collocation | start-state noise {cfg['noise']:g}", flush=True)

    gval = torch.Generator(device=device); gval.manual_seed(1234)
    if full:
        val_ci = val_t
        val_st = torch.zeros(len(val_t), dtype=torch.long, device=device)
    else:
        val_ci, val_st = sample_windows(val_t, L, N_VAL_WINDOWS, gval,
                                        from_start=from_start)  # same mix

    gtr = torch.Generator(device=device); gtr.manual_seed(SEED + 7)

    if start_epoch == 1:
        field.eval()
        with torch.no_grad():
            v0, n0 = 0.0, 0
            for b in range(0, len(val_ci), batch):
                try:
                    _, l_traj, _, _ = run_batch(val_ci[b:b + batch],
                                                val_st[b:b + batch], L, cfg=cfg)
                    v0 += l_traj.item(); n0 += 1
                except Exception:
                    continue
            if n0:
                best = v0 / n0
                print(f"  incoming model scores {best:.4e} on this stage's "
                      f"validation windows (bar to beat)", flush=True)

    for epoch in range(start_epoch, epochs + 1):
        field.train()
        if full:
            order = train_t[torch.randperm(len(train_t), device=device, generator=gtr)]
        tot, tot_traj, tot_der, nb, nfail, nwin_failed = 0.0, 0.0, 0.0, 0, 0, 0
        tot_y = 0.0
        stats = {}
        t0 = time.time()
        for b in range(n_batches):
            if full:
                sl = order[b * batch:(b + 1) * batch]
                if len(sl) == 0:
                    continue
                ci, st = sl, torch.zeros(len(sl), dtype=torch.long, device=device)
            else:
                ci, st = sample_windows(train_t, L, batch, gtr,
                                        from_start=from_start)
            try:
                loss, l_traj, l_der, n_bad = run_batch(
                    ci, st, L, noise=cfg["noise"], cfg=cfg)
                nwin_failed += n_bad
                opt.zero_grad(set_to_none=True)
                loss.backward()
                gn = nn.utils.clip_grad_norm_(field.parameters(), GRAD_CLIP)
                if torch.isfinite(gn):
                    opt.step()
            except Exception as exc:
                nfail += 1
                opt.zero_grad(set_to_none=True)
                if nfail <= 2:
                    print(f"    batch failed ({type(exc).__name__}: {str(exc)[:90]})",
                          flush=True)
                continue
            finally:
                sched.step()
            tot += loss.item(); tot_traj += l_traj.item(); tot_der += l_der.item(); nb += 1
            tot_y += LOSS_PARTS.get("majors_y", 0.0)
            stats = last_call_stats()
        if nb == 0:
            print("  every batch failed this epoch -- stopping stage", flush=True)
            break
        tr = tot / nb

        lr_used = sched.get_last_lr()[0]        # before a possible rollback halves it
        if epoch % VALIDATE_EVERY == 0 or epoch == epochs or epoch == 1:
            field.eval()
            vt, nv = 0.0, 0
            with torch.no_grad():
                for b in range(0, len(val_ci), batch):
                    try:
                        _, l_traj, _, _ = run_batch(val_ci[b:b + batch],
                                                    val_st[b:b + batch], L,
                                                    cfg=cfg)
                        vt += l_traj.item(); nv += 1
                    except Exception:
                        continue
            vl = vt / max(nv, 1) if nv else float("inf")
            rolled_back = False
            if (ROLLBACK_FACTOR is not None and np.isfinite(best)
                    and vl > ROLLBACK_FACTOR * best):
                field.load_state_dict(best_state)
                opt.state.clear()                       # fresh Adam moments
                sched.halve()
                rolled_back = True
            improved = vl < best
            if improved:
                best = vl
                best_state = copy.deepcopy(field.state_dict())
                torch.save({"model": best_state, "val": best, "stage": name,
                            "center": center, "scale": scale, "keep": keep,
                            "kept_names": kept_names, "p_center": p_center,
                            "p_scale": p_scale, "log_eps": LOG_EPS},
                           stage_dir / "best.pt")
            history.append({"epoch": epoch, "train": tr, "val": vl, "lr": lr_used})
            print(f"  epoch {epoch:4d}/{epochs} | train {tr:.4e} "
                  f"(traj {tot_traj/nb:.3e}"
                  f"{f', majors-Y MSE {tot_y/nb:.2e}' if use_y else ''}"
                  f", deriv {tot_der/nb:.3e}) | val {vl:.4e}"
                  f"{' *' if improved else '  '} | lr {lr_used:.2e} "
                  f"| solver: {stats.get('evals', 0)} evals, max "
                  f"{stats.get('max_steps_used', 0)} steps/window "
                  f"| failed batches {nfail}/{n_batches}, "
                  f"windows {nwin_failed} "
                  f"| {time.time()-t0:.0f}s", flush=True)
            if rolled_back:
                print(f"    ROLLBACK: val {vl:.3e} > {ROLLBACK_FACTOR:g} x best "
                      f"{best:.3e} -> reloaded the best weights, lr halved "
                      f"{lr_used:.2e} -> {sched.get_last_lr()[0]:.2e}", flush=True)

        if epoch % ROLLOUT_EVERY == 0 or epoch == epochs:
            ms = [case_metrics(c, continuous_rollout(
                      int(c), allow_fallback=False, max_steps=MAX_STEPS_MONITOR)[0])
                  for c in val_idx[:N_ROLLOUT_CASES]]
            summarize(ms, f"  [epoch {epoch}] val continuous rollout")

        torch.save({"model": field.state_dict(), "opt": opt.state_dict(),
                    "sched": sched.state_dict(), "stage_cfg": stage_cfg,
                    "epoch": epoch, "best": best,
                    "best_state": best_state, "history": history}, latest)

    field.load_state_dict(best_state)
    print(f"  stage {name} done | best val {best:.4e}", flush=True)


